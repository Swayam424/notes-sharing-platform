# Frontend Environment Variables (Set in Vercel Dashboard)
# Set VITE_API_URL to your deployed Render backend URL (e.g. https://notes-sharing-backend.onrender.com)
VITE_API_URL=

# Backend Environment Variables (Set in Render Dashboard or .env for local dev)
PORT=3001
NODE_ENV=development
CLIENT_ORIGINS=https://notes-sharing-platform-psi.vercel.app,http://localhost:5173
TRUST_PROXY=true
GEMINI_API_KEY=
