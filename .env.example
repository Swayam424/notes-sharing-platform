# ==============================================================================
# Atelier Notes Sharing Platform — Environment Configuration Template
# ==============================================================================

# Server Network Configuration
PORT=3001
NODE_ENV=development

# Allowed CORS Origins (comma-separated for multiple origins)
# In production, set to your canonical domain (e.g., https://atelier-notes.edu)
CLIENT_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Rate Limiting & Abuse Prevention
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=1000
AUTH_RATE_LIMIT_MAX=20

# File Upload Thresholds (in bytes or megabytes)
MAX_FILE_SIZE_MB=50
ALLOWED_FILE_EXTENSIONS=.pdf,.jpg,.jpeg,.png,.webp,.docx,.doc

# Database Configuration
DATABASE_PATH=server/data/database.sqlite
SQLITE_WAL_MODE=true

# Reverse proxy hops to trust for client IPs (unset = trust none)
# TRUST_PROXY=1

# Gemini API key for the AI study assistant
# GEMINI_API_KEY=

# Create demo accounts in production (default: off)
# SEED_DEMO_USERS=false
